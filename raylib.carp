(system-include "raylib.h")

(register raylib-version-major Int "RAYLIB_VERSION_MAJOR")
(register raylib-version-minor Int "RAYLIB_VERSION_MINOR")
(register raylib-version-patch Int "RAYLIB_VERSION_PATCH")
(register raylib-version (Ptr Char) "RAYLIB_VERSION")

(register raylib-pi Float "PI") ; Duplication with Carp's `pi`: renaming this to `raylib-pi`
(register deg2rad Float "DEG2RAD")
(register rad2deg Float "RAD2DEG")

(register-type Vector2 [x Float, y Float])
(register-type Vector3 [x Float, y Float, z Float])
(defmodule Vector3
  (defn copy [v]
    (Vector3.init
      @(Vector3.x v)
      @(Vector3.y v)
      @(Vector3.z v)))
  (implements copy copy))
(register-type Vector4 [x Float, y Float, z Float, w Float])
;; (deftype Quaternion Vector4) ; TODO: define Quaternion = Vector4
(register-type Matrix [m0 Float, m4 Float, m8 Float, m12 Float, m1 Float, m5 Float, m9 Float, m13 Float, m2 Float, m6 Float, m10 Float, m14 Float, m3 Float, m7 Float, m11 Float, m15 Float])
(register-type Color [r Byte, g Byte, b Byte, a Byte])
(defmodule Color
  (defn copy [c]
    (Color.init
      @(Color.r c)
      @(Color.g c)
      @(Color.b c)
      @(Color.a c)))
  (implements copy copy))
(register-type Rectangle [x Float, y Float, width Float, height Float])
(register-type Image [data (Ptr ()), width Int32, height Int32, mipmaps Int32, format Int32])
(register-type Texture [id Uint32, width Int32, height Int32, mipmaps Int32, format Int32])
(defmodule Texture
  (defn copy [t]
    (Texture.init
      @(Texture.id t)
      @(Texture.width t)
      @(Texture.height t)
      @(Texture.mipmaps t)
      @(Texture.format t)))
  (implements copy copy))
;; (deftype Texture2D Texture) ; TODO: define Texture2D = Texture
;; (deftype TextureCubemap Texture) ; TODO: define TextureCubemap = Texture
(register-type RenderTexture [id Uint32, texture Texture, depth Texture])
;; (def RenderTexture2D RenderTexture) ; TODO: define RenderTexture2D = RenderTexture
(register-type NPatchInfo [source Rectangle, left Int32, top Int32, right Int32, bottom Int32, layout Int32])
(register-type GlyphInfo [value Int32, offsetX Int32, offsetY Int32, advanceX Int32, image Image])
(register-type Font [baseSize Int32, glyphCount Int32, glyphPadding Int32, texture Texture, recs (Ptr Rectangle), glyphs (Ptr GlyphInfo)]) ; texture: Texture2D
(register-type Camera3D [position Vector3, target Vector3, up Vector3, fovy Float, projection Int])
;; (deftype Camera Camera3D) ; TODO: define Camera = Camera3D
(register-type Camera2D [offset Vector2, target Vector2, rotation Float, zoom Float])
(register-type Mesh [vertexCount Int32, triangleCount Int32, vertices (Ptr Float), texcoords (Ptr Float), texcoords2 (Ptr Float), normals (Ptr Float), tangents (Ptr Float), colors (Ptr Byte), indices (Ptr Uint16), boneCount Int32, boneIndices (Ptr Byte), boneWeights (Ptr Float), animVertices (Ptr Float), animNormals (Ptr Float), vaoId Uint32, vboId (Ptr Uint32)])
(register-type Shader [id Uint32, locs (Ptr Int32)])
(register-type MaterialMap [texture Texture, color Color, value Float]) ; texture: Texture2D
;(register-type Material [shader Shader, maps (Ptr MaterialMap), params (Ptr Float)]) ; params: float[4]
(register-type Material "Material")
(register-type Transform [translation Vector3, rotation Vector4, scale Vector3]) ; rotation: Quaternion
;; (deftype ModelAnimPose (Ptr Transform)) ; TODO: define ModelAnimPose = Transform*
;; (register-type BoneInfo [name (Ptr Byte), parent Int32]) ; name: char[32]
(register-type BoneInfo "BoneInfo")
(register-type ModelSkeleton [boneCount Uint32, bones (Ptr BoneInfo), bindPose (Ptr Transform)]) ; bindPose: ModelAnimPose
(register-type Model [transform Matrix, meshCount Int32, materialCount Int32, meshes (Ptr Mesh), materials (Ptr Material), meshMaterial (Ptr Int32), skeleton ModelSkeleton, currentPose (Ptr Transform), boneMatrices (Ptr Matrix)]) ; currentPose: ModelAnimPose
;; (register-type ModelAnimation [name (Ptr Byte), boneCount Uint32, keyframeCount Int32, keyframePoses (Ptr (Ptr Transform))]) ; name:  char[32], keyframePoses: ModelAnimPose*
(register-type ModelAnimation "ModelAnimation")
(register-type Ray [position Vector3, direction Vector3])
(register-type RayCollision [hit Bool, distance Float, point Vector3, normal Vector3])
(register-type BoundingBox [min Vector3, max Vector3])
(register-type Wave [frameCount Uint32, sampleRate Uint32, sampleSize Uint32, channels Uint32, data (Ptr ())])
(register-type RAudioBuffer "rAudioBuffer") ; AbstractType: Defined in raudio module
(register-type RAudioProcessor "rAudioProcessor") ; AbstractType: Defined in raudio module
(register-type AudioStream [buffer (Ptr RAudioBuffer), processor (Ptr RAudioProcessor), sampleRate Uint32, sampleSize Uint32, channels Uint32])
(register-type Sound [stream AudioStream, frameCount Uint32])
(register-type Music [stream AudioStream, frameCount Uint32, looping Bool, ctxType Int32, ctxData (Ptr ())])
;; (register-type VrDeviceInfo [hResolution Int32, vResolution Int32, hScreenSize Float, vScreenSize Float, eyeToScreenDistance Float, lensSeparationDistance Float, interpupillaryDistance Float, lensDistortionValues (Ptr Float), chromaAbCorrection (Ptr Float)]) ; lensDistortionValues: float[4], chromaAbCorrection: float[4]
(register-type VrDeviceInfo "VrDeviceInfo")
;;(register-type VrStereoConfig [projection (Ptr Matrix), viewOffset (Ptr Matrix), leftLensCenter (Ptr Float), rightLensCenter (Ptr Float), leftScreenCenter (Ptr Float), rightScreenCenter (Ptr Float), scale (Ptr Float), scaleIn (Ptr Float)]) ; projection: Matrix[2], viewOffset: Matrix[2], leftLensCenter: float[2], rightLensCenter: float[2], leftScreenCenter: float[2], rightScreenCenter: float[2], scale: float[2], scaleIn: float[2]
(register-type VrStereoConfig "VrStereoConfig")
(register-type _CChar "char")
(register-type FilePathList [count Uint32, paths (Ptr (Ptr _CChar))])
;; (register-type AutomationEvent [frame Uint32, type Uint32, params (Ptr Int32)]) ; params: int[4]
(register-type AutomationEvent "AutomationEvent")
(register-type AutomationEventList [capacity Uint32, count Uint32, events (Ptr AutomationEvent)])

