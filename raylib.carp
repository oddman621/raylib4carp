(register pause-audio-stream (λ [AudioStream] ()) "PauseAudioStream")
(register resume-audio-stream (λ [AudioStream] ()) "ResumeAudioStream")
(register is-audio-stream-playing (λ [AudioStream] Bool) "IsAudioStreamPlaying")
(register stop-audio-stream (λ [AudioStream] ()) "StopAudioStream")
(register set-audio-stream-volume (λ [AudioStream Float] ()) "SetAudioStreamVolume")
(register set-audio-stream-pitch (λ [AudioStream Float] ()) "SetAudioStreamPitch")
(register set-audio-stream-pan (λ [AudioStream Float] ()) "SetAudioStreamPan")
(register set-audio-stream-buffer-size-default (λ [Int] ()) "SetAudioStreamBufferSizeDefault")
(register set-audio-stream-callback (λ [AudioStream AudioCallback] ()) "SetAudioStreamCallback")
(register attach-audio-stream-processor (λ [AudioStream AudioCallback] ()) "AttachAudioStreamProcessor")
(register detach-audio-stream-processor (λ [AudioStream AudioCallback] ()) "DetachAudioStreamProcessor")
(register attach-audio-mixed-processor (λ [AudioCallback] ()) "AttachAudioMixedProcessor")
(register detach-audio-mixed-processor (λ [AudioCallback] ()) "DetachAudioMixedProcessor")

(register is-window-state (λ [Uint32] Bool) "IsWindowState")
(register set-window-state (λ [Uint32] ()) "SetWindowState")
(register clear-window-state (λ [Uint32] ()) "ClearWindowState")
(register get-monitor-name (λ [Int32] (Ptr CChar)) "GetMonitorName")
(register get-clipboard-text (λ [] (Ptr CChar)) "GetClipboardText")
(register set-random-seed (λ [Uint32] ()) "SetRandomSeed")
(register load-random-sequence (λ [Uint32 Int32 Int32] (Ptr Int32)) "LoadRandomSequence")
(register load-file-data (λ [(Ptr CChar) Int32] (Ptr Byte)) "LoadFileData")
(register unload-file-data (λ [(Ptr Byte)] ()) "UnloadFileData")
(register export-data-as-code (λ [(Ptr Byte) Int32 (Ptr CChar)] Bool) "ExportDataAsCode")
(register unload-file-text (λ [(Ptr CChar)] (Ptr CChar)) "UnloadFileText")
